# Шаблон сайта для nginx на хосте при запуске без Docker (systemd + gunicorn на unix-сокете).
# Не править собранный deploy/nginx-site.conf: его пересобирает make nginx-update (и service-deploy) —
# подставляет @SERVICE@, @MEDIA_ROOT@ и @CANONICAL_HOST@ (из src/.env), @SERVER_NAME@, @CERT_DIR@ (переменные make).
# Вместо uwsgi_pass старого сайта — proxy_pass в сокет gunicorn. Подключение — make nginx-install (symlink в sites-available).

upstream @SERVICE@_web {
    server unix:/run/@SERVICE@/gunicorn.sock fail_timeout=0;
}

# Подбор пароля к админке: не больше 10 попыток входа в минуту с адреса (+5 сразу), дальше — 429.
limit_req_zone $binary_remote_addr zone=@SERVICE@_admin_login:10m rate=10r/m;

server {
    listen 80;
    listen [::]:80;
    server_name @SERVER_NAME@;

    # Сразу на главный домен по https: http://www… — одним редиректом, без промежуточного www.
    location / {
        return 301 https://@CANONICAL_HOST@$request_uri;
    }
}

server {
    # http2 в listen, а не «http2 on;»: директиву знает только nginx 1.25.1+, а в Ubuntu 22.04/24.04 — 1.18/1.24.
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name @SERVER_NAME@;
    server_tokens off;

    ssl_certificate @CERT_DIR@/fullchain.pem;
    ssl_certificate_key @CERT_DIR@/privkey.pem;

    # Загрузка фото пачкой в админке.
    client_max_body_size 200m;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json application/xml image/svg+xml;
    gzip_min_length 1024;

    # X-Real-IP перезаписывается адресом клиента: по нему django-axes блокирует подбор пароля.
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 120s;
    proxy_redirect off;

    location /media/ {
        alias @MEDIA_ROOT@/;
        autoindex off;
        # Имена файлов уникальны (UploadTo — случайные, CACHE/ imagekit — хеши), поэтому кешируем навсегда.
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location = /admin/login/ {
        limit_req zone=@SERVICE@_admin_login burst=5 nodelay;
        limit_req_status 429;
        proxy_pass http://@SERVICE@_web;
    }

    # Статику (/static/) отдаёт WhiteNoise внутри gunicorn — со сжатием и вечным кешем.
    location / {
        proxy_pass http://@SERVICE@_web;
    }
}
