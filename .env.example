# Продакшен (docker compose). Для локальной разработки — src/.env.example.
DEBUG=0
SECRET_KEY=
ALLOWED_HOSTS=t-camp.ru,www.t-camp.ru
CSRF_TRUSTED_ORIGINS=https://t-camp.ru,https://www.t-camp.ru
# Главный домен: с www.t-camp.ru — 301 на t-camp.ru.
CANONICAL_HOST=t-camp.ru
# http → https в Django (прокси должен передавать X-Forwarded-Proto). 0 — если редирект делает прокси.
SECURE_SSL_REDIRECT=1
# Только для docker compose:
PROXY_NETWORK=proxy
WEB_CONCURRENCY=3
HSTS_SECONDS=31536000
# Только для compose.nginx.yaml (свой nginx вместо общего прокси):
# COMPOSE_FILE=compose.nginx.yaml   # тогда docker compose, make up/logs и scripts/backup.sh работают с ним без -f
# SERVER_NAME=t-camp.ru www.t-camp.ru
# CERT_NAME=t-camp.ru               # каталог в /etc/letsencrypt/live/
# LETSENCRYPT_DIR=/etc/letsencrypt
# ACME_WEBROOT=/var/www/certbot
# HTTP_PORT=80
# HTTPS_PORT=443
