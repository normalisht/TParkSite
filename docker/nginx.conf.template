# Свой nginx для compose.nginx.yaml. ${SERVER_NAME} и ${CERT_NAME} подставляет envsubst образа nginx,
# остальные $-переменные — переменные nginx и не трогаются.

upstream tpark_web {
    server tpark-web:8000;
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name ${SERVER_NAME};
    server_tokens off;

    # Продление сертификатов: certbot на хосте кладёт сюда ответы (--webroot -w ACME_WEBROOT).
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${SERVER_NAME};
    server_tokens off;

    ssl_certificate /etc/letsencrypt/live/${CERT_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${CERT_NAME}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    # Загрузка фото пачкой в админке.
    client_max_body_size 200m;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json application/xml image/svg+xml;
    gzip_min_length 1024;

    location /media/ {
        alias /data/media/;
        autoindex off;
        expires 30d;
        add_header Cache-Control "public";
    }

    location / {
        proxy_pass http://tpark_web;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}
