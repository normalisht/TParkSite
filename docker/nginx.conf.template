# Свой nginx для compose.nginx.yaml — полный nginx.conf: load_module нельзя подключить из conf.d.
# ${SERVER_NAME}, ${ACME_EMAIL}, ${ACME_SERVER} подставляет envsubst образа nginx,
# остальные $-переменные — переменные nginx и не трогаются.
# Сертификат Let's Encrypt выпускает и продлевает сам nginx (ngx_http_acme_module, HTTP-01 на порту 80).

load_module modules/ngx_http_acme_module.so;

user nginx;
worker_processes auto;

error_log /var/log/nginx/error.log notice;
pid /run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log /var/log/nginx/access.log;
    sendfile on;
    keepalive_timeout 65;
    server_tokens off;

    # DNS Docker: нужен модулю ACME, чтобы достучаться до Let's Encrypt.
    resolver 127.0.0.11 ipv6=off;

    acme_issuer letsencrypt {
        uri ${ACME_SERVER};
        contact ${ACME_EMAIL};
        state_path /var/cache/nginx/acme-letsencrypt;
        accept_terms_of_service;
    }

    acme_shared_zone zone=ngx_acme_shared:1M;

    upstream tpark_web {
        server tpark-web:8000;
        keepalive 16;
    }

    # Порт 80 обязателен: на нём модуль сам отвечает на /.well-known/acme-challenge/.
    server {
        listen 80;
        listen [::]:80;
        server_name ${SERVER_NAME};

        location / {
            return 301 https://$host$request_uri;
        }
    }

    server {
        listen 443 ssl;
        listen [::]:443 ssl;
        http2 on;
        server_name ${SERVER_NAME};

        acme_certificate letsencrypt;
        ssl_certificate $acme_certificate;
        ssl_certificate_key $acme_certificate_key;
        ssl_certificate_cache max=2;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_prefer_server_ciphers off;
        ssl_session_cache shared:SSL:10m;
        ssl_session_timeout 1d;

        # Загрузка фото пачкой в админке.
        client_max_body_size 200m;

        gzip on;
        gzip_types text/plain text/css application/javascript application/json application/xml image/svg+xml;
        gzip_min_length 1024;

        location /media/ {
            alias /data/media/;
            autoindex off;
            # Имена файлов уникальны (UploadTo — случайные, CACHE/ imagekit — хеши), поэтому кешируем навсегда.
            expires 1y;
            add_header Cache-Control "public, immutable";
        }

        location / {
            proxy_pass http://tpark_web;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_read_timeout 120s;
        }
    }
}
