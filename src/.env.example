# Локальная разработка (cp .env.example .env). Продакшен — корневой .env.example.
DEBUG=1
# При DEBUG=1 можно оставить пустым — подставится небезопасный dev-ключ.
SECRET_KEY=
# localhost и 127.0.0.1 добавляются всегда; сюда — дополнительные хосты (например, адрес в локальной сети).
ALLOWED_HOSTS=localhost,127.0.0.1
# Нужен, если заходите не через localhost (например, https-туннель): https://xxx.example.com
CSRF_TRUSTED_ORIGINS=
# Главный домен: с www.<CANONICAL_HOST> — 301 сюда. Пусто — без редиректа.
CANONICAL_HOST=t-camp.ru

# Кнопка «Сгенерировать» на вкладке SEO в админке: ключ с openrouter.ai. Пусто — кнопки нет.
OPENROUTER_API_KEY=
# Модель; по умолчанию openrouter/free — сам выбирает из бесплатных.
# OPENROUTER_MODEL=openrouter/free
# IndexNow — только на продакшене: с ключом и CANONICAL_HOST локальные правки уходили бы в Яндекс как адреса сайта.
# INDEXNOW_KEY=

# Пути — абсолютные; по умолчанию src/db.sqlite3, src/media, src/staticfiles.
# DATABASE_PATH=/path/to/db.sqlite3
# MEDIA_ROOT=/path/to/media
# STATIC_ROOT=/path/to/staticfiles

# Действуют только при DEBUG=0 (проверка продакшен-режима локально):
# SECURE_SSL_REDIRECT=0
# HSTS_SECONDS=0
